{
  "ci": {
    "collect": {
      "url": ["http://localhost:8080"],
      "startServerCommand": "npm run start", 
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "performance:minScore": "0.90", 
        "categories.pwa.score": "0.90", 
        "first-contentful-paint:maxNumeric": 2000, 
        "total-blocking-time:maxNumeric": 300  
      }
    },
    "upload": {
      "target": "lhci"
    }
  }
}